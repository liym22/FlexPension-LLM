# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# API Keys for Teacher Model Inference
# ============================================================================

# OpenRouter API key used by teacher inference and the historical screening runner
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Unified closed-model benchmark service
CLOSEAI_API_KEY=your_closeai_api_key_here
CLOSEAI_ADMIN_KEY=your_closeai_admin_key_here
CLOSEAI_CHAT_URL=https://api.openai-proxy.org/v1/chat/completions
CLOSEAI_MODELS_URL=https://api.openai-proxy.org/api/v1/management/models

# ============================================================================
# Server Paths (for training and inference on remote server)
# ============================================================================

# Server base directory (REQUIRED for all training/inference scripts)
SERVER_BASE=/path/to/your/server/base

# Conda environment (REQUIRED for training/inference scripts)
SERVER_CONDA_PATH=${SERVER_BASE}/miniconda3
SERVER_CONDA_ENV=my_qlora_env

# Exact base-model ID or local model directory (REQUIRED)
SERVER_MODEL_PATH=Qwen/Qwen3.5-35B-A3B

# Dataset directory (REQUIRED for training/inference scripts)
SERVER_DATASET_DIR=${SERVER_BASE}/datasets

# Private JSONL files for the four external evaluation datasets
SERVER_EXTERNAL_DATASET_DIR=${SERVER_BASE}/external_datasets

# Output directory (REQUIRED for training/inference scripts)
SERVER_OUTPUT_DIR=${SERVER_BASE}/outputs

# Logs directory (optional)
SERVER_LOGS_DIR=${SERVER_OUTPUT_DIR}/logs
