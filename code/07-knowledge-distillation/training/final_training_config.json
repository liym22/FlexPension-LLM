{
  "model": "Qwen/Qwen3.5-35B-A3B",
  "framework": "ms-swift 4.0.2",
  "method": "LoRA/SFT",
  "epochs": 3,
  "learning_rate": 0.0001,
  "lr_scheduler_type": "cosine",
  "warmup_steps": 0,
  "weight_decay": 0.1,
  "optimizer": "adamw_torch_fused",
  "adam_beta1": 0.9,
  "adam_beta2": 0.95,
  "adam_epsilon": 1e-08,
  "lora_rank": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "target_modules": "all-linear",
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 2,
  "num_devices": 8,
  "global_batch_size": 16,
  "max_length": 4096,
  "precision": "bfloat16",
  "gradient_checkpointing": true,
  "deepspeed": "zero3",
  "seed": 42,
  "data_seed": 42,
  "eval_steps": 200,
  "save_steps": 100,
  "logging_steps": 5
}
